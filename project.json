{
  "name": "MeetingTranslator",
  "options": {
    "minimumXcodeGenVersion": "2.46.0",
    "xcodeVersion": "26.4",
    "developmentLanguage": "ko",
    "deploymentTarget": {
      "iOS": "26.0",
      "watchOS": "26.0"
    },
    "createIntermediateGroups": true
  },
  "configs": {
    "Debug": "debug",
    "Release": "release"
  },
  "configFiles": {
    "Debug": "Config/Base.xcconfig",
    "Release": "Config/Base.xcconfig"
  },
  "settings": {
    "base": {
      "SWIFT_VERSION": "5.0",
      "MARKETING_VERSION": "0.1.0",
      "CURRENT_PROJECT_VERSION": "1",
      "CODE_SIGN_STYLE": "Automatic",
      "ENABLE_USER_SCRIPT_SANDBOXING": "YES"
    }
  },
  "packages": {
    "TranslatorCore": {
      "path": "Packages/TranslatorCore"
    }
  },
  "targets": {
    "MeetingTranslator": {
      "type": "application",
      "platform": "iOS",
      "deploymentTarget": "26.0",
      "sources": [
        {
          "path": "Apps/iOS",
          "excludes": [
            "Info.plist"
          ]
        },
        {
          "path": "Apps/Shared"
        }
      ],
      "info": {
        "path": "Apps/iOS/Info.plist",
        "properties": {
          "CFBundleDisplayName": "회의 번역",
          "UILaunchScreen": {},
          "NSMicrophoneUsageDescription": "음성 번역과 회의 기록을 위해 마이크를 사용합니다.",
          "NSSpeechRecognitionUsageDescription": "말한 내용을 텍스트로 변환합니다.",
          "UISupportedInterfaceOrientations": [
            "UIInterfaceOrientationPortrait",
            "UIInterfaceOrientationLandscapeLeft",
            "UIInterfaceOrientationLandscapeRight"
          ]
        }
      },
      "settings": {
        "base": {
          "PRODUCT_BUNDLE_IDENTIFIER": "$(IPHONE_BUNDLE_IDENTIFIER)",
          "TARGETED_DEVICE_FAMILY": "1",
          "GENERATE_INFOPLIST_FILE": "NO"
        }
      },
      "dependencies": [
        {
          "package": "TranslatorCore"
        },
        {
          "target": "MeetingTranslatorWatch",
          "embed": true,
          "link": false,
          "copy": {
            "destination": "plugins"
          }
        }
      ]
    },
    "MeetingTranslatorWatch": {
      "type": "application",
      "platform": "watchOS",
      "deploymentTarget": "26.0",
      "sources": [
        {
          "path": "Apps/watchOS",
          "excludes": [
            "Info.plist"
          ]
        },
        {
          "path": "Apps/Shared"
        }
      ],
      "info": {
        "path": "Apps/watchOS/Info.plist",
        "properties": {
          "CFBundleDisplayName": "회의 번역",
          "WKApplication": true,
          "WKCompanionAppBundleIdentifier": "$(IPHONE_BUNDLE_IDENTIFIER)",
          "WKRunsIndependentlyOfCompanionApp": false
        }
      },
      "settings": {
        "base": {
          "PRODUCT_BUNDLE_IDENTIFIER": "$(WATCH_BUNDLE_IDENTIFIER)",
          "SKIP_INSTALL": "YES",
          "GENERATE_INFOPLIST_FILE": "NO"
        }
      },
      "dependencies": [
        {
          "package": "TranslatorCore"
        }
      ]
    }
  },
  "schemes": {
    "MeetingTranslator": {
      "build": {
        "targets": {
          "MeetingTranslator": "all"
        }
      },
      "run": {
        "config": "Debug"
      },
      "archive": {
        "config": "Release"
      }
    },
    "MeetingTranslatorWatch": {
      "build": {
        "targets": {
          "MeetingTranslatorWatch": "all"
        }
      },
      "run": {
        "config": "Debug"
      }
    }
  },
  "fileGroups": [
    "README.md",
    "docs",
    "Config"
  ]
}
